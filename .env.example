# ----------------------------------------------------
# Riders Path — Server Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ----------------------------------------------------

# Server Port (Default: 3000)
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Database path (SQLite for local dev/testing)
DATABASE_PATH=./data/riders_path.db

# Random 32+ character secret for HMAC cookie/session signing
SESSION_SECRET=change_me_to_a_random_32_character_string_for_production

# CORS allowed frontend origin (e.g. your Vite dev server or production URL)
CORS_ORIGIN=http://localhost:5173

# Admin credentials (Username and salted bcrypt hash of password)
# To generate a hash: node -e 'console.log(require("bcryptjs").hashSync("YourPassword123!", 10))'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$wE6O6Rkm3y1rV7YVp5QeEeZcK/25K4V5f0E4y39mO54kG8Fw6p3jS

# Student campus email domains (comma-separated).
# Set the institution's real domain(s). Empty means OTP login stays unavailable.
ALLOWED_EMAIL_DOMAINS=

# Student Enrollment Number Format Regex & Human Example
# Placeholder accepts 4-20 letters, digits, and hyphens. Replace with the real format.
ENROLLMENT_FORMAT_REGEX=^[A-Za-z0-9-]{4,20}$
ENROLLMENT_FORMAT_EXAMPLE=ABCD-123 (placeholder)

# OTP Security Parameters
# Generate a unique random secret with: openssl rand -hex 32
OTP_HMAC_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# SMTP Email Dispatch (required in production; development logs OTPs locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google Gemini API Key (Optional: Server-side document verification OCR only)
# GEMINI_API_KEY=your_gemini_api_key_here
